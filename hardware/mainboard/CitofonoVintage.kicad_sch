	(text "Disco S62: 1-2 = contatto impulsi cid (NC, si apre ad ogni impulso); 3-4 = contatto cld (chiuso durante la rotazione)."
		(exclude_from_sim no)
		(at 20 240 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "1f425a03-0149-42b6-a112-31369e08158b")
	)
	(text "J5: 1=fonia entrata, 2=fonia uscita, 6=comune, 9=apriporta, CA=chiamata (12 V AC misurati tra 6 e CA)"
		(exclude_from_sim no)
		(at 20 155 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4a7f5d4b-9b39-49aa-b813-2a8eba0799c2")
	)
	(text "J8/J9/J10: header per la daughterboard codec (ES8388) della V3 Pro. Con JP1/JP2 aperti il codec si inserisce fra linea (J10) e cornetta (J9)."
		(exclude_from_sim no)
		(at 290 256 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "61574f8d-a0ad-49c9-a94f-9eb97870a711")
	)
	(text "JP1/JP2 chiusi = audio analogico passante (V2 Plus). Aperti in V3 Pro: il codec sulla daughterboard (J8) si inserisce fra linea e cornetta."
		(exclude_from_sim no)
		(at 150 244 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "63a5f3d4-2645-40c7-b939-4dea4102c8c2")
	)
	(text "USB-C: programmazione via USB nativo S3 (IO19/20) e alimentazione da banco (VBUS -> D4 -> +5V). CC 5.1k = sink."
		(exclude_from_sim no)
		(at 340 182 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "643e30ce-ada6-4dee-be33-e0588dac9014")
	)
	(text "Sense chiamata: R14 dimensionata sul worst case 31 V DC (~2 mA), conduce ancora a 12 V AC raddrizzati. C12 filtra la semionda 50 Hz."
		(exclude_from_sim no)
		(at 60 152 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7555841a-1163-49a2-9875-fe8efe122d77")
	)
	(text "R1/R2: UVLO ~7.5 V (EN thr 1.5 V). R3: RON 49.9k -> ~250 kHz @5V. R4/R5: Vout = 1.2V*(1+100k/31.6k) = 5.0 V"
		(exclude_from_sim no)
		(at 20 100 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "81a6da2b-39ba-4ab5-b053-d506bc4f46fe")
	)
	(text "J4 (rev 0.3, pin 1 a sinistra): 1-2 = HS2/HS1 secondo contatto gancio GC per il sense (lato logica); 3-4-5 = M/R, HK1, HK2 contatto gancio (chiude M/R su 6); 6-7 = R, M cornetta (lato linea)."
		(exclude_from_sim no)
		(at 20 254 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "94364ca7-7095-4532-ba34-4b1d449cc032")
	)
	(text "K2 in parallelo al contatto gancio (M/R<->6): simula il sollevamento cornetta per rispondere/aprire da remoto."
		(exclude_from_sim no)
		(at 140 196 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "968b6f9d-b4ed-4b2a-aaf9-5b377b20e8d4")
	)
	(text "BLOCCO A2 - INTERFACCIA LINEA CITOFONO URMET 4+N  (isolata: opto sense chiamata, SSR apriporta K1 9<->6, SSR sgancio K2)"
